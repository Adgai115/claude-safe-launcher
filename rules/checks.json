{
  "schemaVersion": 1,
  "rulesVersion": "4.0.0",
  "categories": [
    {
      "id": "proxy-net",
      "titleZh": "代理与网络"
    },
    {
      "id": "exit",
      "titleZh": "出口一致性"
    },
    {
      "id": "locale",
      "titleZh": "地区一致性"
    },
    {
      "id": "cfg",
      "titleZh": "本机配置"
    },
    {
      "id": "auto",
      "titleZh": "浏览器自动化痕迹"
    },
    {
      "id": "meta",
      "titleZh": "内部（保留）"
    }
  ],
  "severityEnum": {
    "must_fix": "必须修",
    "should_fix": "建议修",
    "info": "仅提示"
  },
  "scoring": {
    "mode": "reference_only",
    "formula": "max(0, 100 - sum(refDeduction))",
    "staticBrowserCap": 20,
    "staticBrowserCheckIds": [
      "net.browser_webrtc_chromium",
      "net.browser_webrtc_firefox",
      "locale.browser_lang_static"
    ],
    "verdict": "canLaunchSafely iff no must_fix failed"
  },
  "meta": [
    {
      "id": "meta.snapshot_freshness",
      "notes": "UTC abs diff >3min or no ts → skip live browser items; info; 0"
    },
    {
      "id": "meta.browser_extensions",
      "notes": "proxy/fingerprint extensions → info"
    },
    {
      "id": "meta.static_warn_cap",
      "notes": "static browser warn refDeduction sum capped at 20; excess demoted to info"
    }
  ],
  "checks": [
    {
      "id": "net.clash_running",
      "category": "proxy-net",
      "title": "Clash Verge 进程",
      "checks": "Clash Verge 是否在跑",
      "expected": "进程存在",
      "severity": "must_fix",
      "refDeduction": 25,
      "recheckWin": "powershell -NoProfile -ExecutionPolicy Bypass -File claude-preflight.ps1 -NoLaunch -NoPause",
      "recheckMac": "python3 mac/claude_preflight.py --no-launch --no-pause",
      "platforms": [
        "win",
        "mac"
      ],
      "masking": "不打印路径中的用户名以外的敏感项",
      "notes": "v4 禁止静默 Start-Process；现状=静默启动",
      "fixType": "confirm",
      "fixId": "clash.start",
      "containsIp": false
    },
    {
      "id": "net.mihomo_core",
      "category": "proxy-net",
      "title": "代理内核 mihomo",
