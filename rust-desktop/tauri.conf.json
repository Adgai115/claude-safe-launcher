{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude 环境检查器",
  "version": "0.1.29",
  "identifier": "io.github.adgai115.claude-safe-launcher-rust",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude 环境检查器",
        "width": 1080,
        "height": 780,
        "minWidth": 620,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../LICENSE.zh-Hans.txt": "LICENSE.zh-Hans.txt"
    },
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"] } }
  }
}
